<% controls = local_assigns[:controls].to_s.strip.presence %>
<% realtime_note = local_assigns[:realtime_note].to_s.strip.presence %>
<% row_label = local_assigns[:row_label].to_s.strip.presence || "rows" %>
<% initial_count = local_assigns[:initial_count] %>
<% initial_updated = local_assigns[:initial_updated].to_s.strip.presence || "loading..." %>
<% initial_state = local_assigns[:initial_state].to_s.strip.presence || "Loading..." %>

<div class="table-meta-bar">
  <%= render "shared/table_usage_hint", controls: controls, realtime_note: realtime_note %>
  <p class="meta table-meta-runtime">
    <span class="table-meta-runtime-item"><strong data-table-meta-count><%= initial_count.nil? ? 0 : initial_count %></strong> <%= row_label %></span>
    <span class="table-meta-divider" aria-hidden="true">|</span>
    <span class="table-meta-runtime-item">Updated <span data-table-meta-updated><%= initial_updated %></span></span>
    <span class="table-meta-divider" aria-hidden="true">|</span>
    <span class="table-meta-runtime-item" data-table-meta-state><%= initial_state %></span>
  </p>
</div>
